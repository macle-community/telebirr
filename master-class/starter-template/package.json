{
  "name": "macle-telebirr-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal React and Taro starter for Macle Mini App lessons",
  "scripts": {
    "build:macle": "taro build --type macle",
    "dev:macle": "taro build --type macle --watch",
    "sim:macle": "npm run build:macle && macle-simulator-web -s ./dist -p 30005",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "^4.3.2",
    "@tarojs/helper": "^4.3.2",
    "@tarojs/plugin-framework-react": "^4.3.2",
    "@tarojs/react": "^4.3.2",
    "@tarojs/runtime": "^4.3.2",
    "@tarojs/shared": "^4.3.2",
    "@tarojs/taro": "^4.3.2",
    "@macle-community/simulator-web": "1.0.1",
    "@macle-community/taro-plugin-macle": "1.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@tarojs/cli": "^4.3.2",
    "@tarojs/plugin-platform-macle": "npm:@macle-community/taro-plugin-macle@1.0.1",
    "@tarojs/webpack5-runner": "^4.3.2",
    "@types/react": "^18.0.0",
    "autoprefixer": "^10.4.20",
    "typescript": "^5.0.4"
  }
}
